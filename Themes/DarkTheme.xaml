<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Renkler -->
    <Color x:Key="ArkaPlanRenk">#FF0B0F1A</Color>
    <Color x:Key="SidebarRenk">#FF11162A</Color>
    <Color x:Key="KartRenk">#FF161B2E</Color>
    <Color x:Key="KartKenarRenk">#FF232945</Color>
    <Color x:Key="VurguRenk">#FF7C5CFF</Color>
    <Color x:Key="Vurgu2Renk">#FF00E5FF</Color>
    <Color x:Key="YaziRenk">#FFE6EAF2</Color>
    <Color x:Key="SolukYaziRenk">#FF8A93A6</Color>
    <Color x:Key="BasariRenk">#FF22C55E</Color>
    <Color x:Key="TehlikeRenk">#FFEF4444</Color>
    <Color x:Key="UyariRenk">#FFF59E0B</Color>

    <SolidColorBrush x:Key="ArkaPlanFirca" Color="{StaticResource ArkaPlanRenk}"/>
    <SolidColorBrush x:Key="SidebarFirca" Color="{StaticResource SidebarRenk}"/>
    <SolidColorBrush x:Key="KartFirca" Color="{StaticResource KartRenk}"/>
    <SolidColorBrush x:Key="KartKenarFirca" Color="{StaticResource KartKenarRenk}"/>
    <SolidColorBrush x:Key="VurguFirca" Color="{StaticResource VurguRenk}"/>
    <SolidColorBrush x:Key="Vurgu2Firca" Color="{StaticResource Vurgu2Renk}"/>
    <SolidColorBrush x:Key="YaziFirca" Color="{StaticResource YaziRenk}"/>
    <SolidColorBrush x:Key="SolukYaziFirca" Color="{StaticResource SolukYaziRenk}"/>
    <SolidColorBrush x:Key="BasariFirca" Color="{StaticResource BasariRenk}"/>
    <SolidColorBrush x:Key="TehlikeFirca" Color="{StaticResource TehlikeRenk}"/>
    <SolidColorBrush x:Key="UyariFirca" Color="{StaticResource UyariRenk}"/>

    <DropShadowEffect x:Key="KartGolge" BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#FF000000"/>

    <!-- Pencere -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource ArkaPlanFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource YaziFirca}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Buton -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource VurguFirca}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5" Effect="{StaticResource KartGolge}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource KartFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource YaziFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KartKenarFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CaretBrush" Value="{StaticResource Vurgu2Firca}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource VurguFirca}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource KartFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource YaziFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KartKenarFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource KartFirca}"/>
        <Setter Property="Foreground" Value="{StaticResource YaziFirca}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KartKenarFirca}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource KartFirca}"/>
        <Setter Property="AlternatingRowBackground" Value="#FF1C2238"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#FF232945"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="RowHeight" Value="30"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FF1C2238"/>
        <Setter Property="Foreground" Value="{StaticResource Vurgu2Firca}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource KartKenarFirca}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF252B45"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource VurguFirca}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="#FF1C2238"/>
        <Setter Property="Foreground" Value="{StaticResource Vurgu2Firca}"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- TabControl (sidebar) -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SolukYaziFirca}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,10" Margin="8,2"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource VurguFirca}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF252B45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Animasyonlu kart -->
    <Style x:Key="AnimasyonluKart" TargetType="Border">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="20"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect" Value="{StaticResource KartGolge}"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- TextBlock başlık stili -->
    <Style x:Key="BaslikText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Vurgu2Firca}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
</ResourceDictionary>